# ==============================================================================
# PROVEDOR DE BACKEND
# ==============================================================================
# Escolha o provedor: 'supabase' (sem backend próprio) ou 'custom' (Node/Express)
VITE_BACKEND_PROVIDER=supabase

# --- Opção 1: Supabase (BaaS direto na nuvem) ---
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# --- Opção 2: Backend Próprio Express (Porta 3001) ---
VITE_API_URL=http://localhost:3001/api
