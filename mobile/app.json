{
  "expo": {
    "name": "DQ Finanças",
    "slug": "expense-home-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dqfinancas",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1a14"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 3000,
      "url": "https://u.expo.dev/0ed41d68-929a-4777-bc29-6e68878a4826"
    },
    "plugins": [
      "expo-updates"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dqfinancas.app",
      "icon": "./src/assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0d1a14"
      },
      "package": "com.dqfinancas.app",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "dqfinancas"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./src/assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0ed41d68-929a-4777-bc29-6e68878a4826"
      }
    },
    "owner": "dholand4"
  }
}
