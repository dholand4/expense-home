# ==============================================================================
# PROVEDOR DE BACKEND MOBILE
# ==============================================================================
# Opções: 'supabase' (sem servidor) ou 'custom' (Node/Express)
EXPO_PUBLIC_BACKEND_PROVIDER=supabase

# --- Opção 1: Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# --- Opção 2: Backend Próprio Express ---
EXPO_PUBLIC_API_URL=http://localhost:3001/api
